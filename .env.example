# DeepSeek：文本查询改写、答案生成和 claim-level verification。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen-VL：Figure 离线描述与 query-conditioned 原图阅读。
QWEN_VL_API_KEY=YOUR_QWEN_VL_API_KEY
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_VL_MODEL=qwen-vl-max

# PDF：Docling 优先，失败时自动降级为 PyMuPDF。
PARSER_BACKEND=docling

# Retrieval：本地 BGE-M3、Qdrant 与可选 BGE reranker。
ENABLE_VECTOR_SEARCH=true
ENABLE_RERANKER=true
QDRANT_URL=
# CPU 友好的精排预算：先由 hybrid 召回，再精排最多 8 个、每对最多 256 tokens。
RERANK_CANDIDATE_LIMIT=8
RERANK_MAX_LENGTH=256

# Agent：硬性步数上限；只精读被 Figure Retrieval 命中的少量原图。
AGENT_MAX_STEPS=6
AGENT_FIGURE_READ_LIMIT=2

# 在线视觉二次核验会额外调用一次 Qwen-VL；默认关闭。离线 --judge 不受此项影响。
ENABLE_ONLINE_VISUAL_JUDGE=false

# legacy | langgraph。默认保留已验证的单 Agent 执行器。
AGENT_ORCHESTRATOR=langgraph
MULTI_AGENT_MAX_STEPS=10
MULTI_AGENT_MAX_RETRIES=1
MULTI_AGENT_TIMEOUT_SECONDS=120
MULTI_AGENT_PARALLEL_ENABLED=false
MULTI_AGENT_MAX_MODEL_CALLS=8
MULTI_AGENT_MAX_QWEN_VL_CALLS=2
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_PATH=data/langgraph-checkpoints.sqlite3
TABLE_VLM_FALLBACK_ENABLED=false
REMOTE_MAX_RETRIES=2
REMOTE_RETRY_BASE_DELAY_SECONDS=0.25

# Conversation、上下文解析与 SSE。首期事件总线仅支持单进程。
ENABLE_CONVERSATIONS=true
ENABLE_QUERY_RESOLVER=true
CONVERSATION_RECENT_TURNS=6
CONVERSATION_SUMMARY_TRIGGER_TURNS=6
CONVERSATION_CONTEXT_MAX_CHARS=12000
ENABLE_SSE=true
SSE_HEARTBEAT_SECONDS=15
SSE_ANSWER_CHUNK_CHARS=12
SSE_ANSWER_CHUNK_DELAY_MS=30
RUN_EVENT_BUFFER_SIZE=200
RUN_EVENT_RETENTION_SECONDS=600

# fixed | function_calling_with_fallback。Function Calling 失败时回退固定流程。
SPECIALIST_EXECUTION_MODE=function_calling_with_fallback
FUNCTION_CALL_STRICT=true
FUNCTION_CALL_TOOL_RESULT_MAX_CHARS=16000
FUNCTION_CALL_CIRCUIT_FAILURE_THRESHOLD=3
FUNCTION_CALL_CIRCUIT_COOLDOWN_SECONDS=60
FUNCTION_CALL_MAX_STEPS=4
FUNCTION_CALL_MAX_MODEL_ROUNDS=3

# LLMOps：Metrics 默认启用；OTLP Endpoint 留空时只创建本地 Span，不发送外部服务。
ENABLE_LLMOPS=true
ENABLE_STRUCTURED_LOGGING=true
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_OTEL=true
OTEL_SERVICE_NAME=paperlens
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=paperlens

# 论文级长期记忆生命周期。
MEMORY_RETENTION_DAYS=365
MEMORY_MAX_ITEMS_PER_PAPER=200
MEMORY_BACKFILL_ENABLED=true
